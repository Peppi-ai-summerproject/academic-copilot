APP_NAME=AI Academic Copilot API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

DATABASE_URL=sqlite:///./academic_copilot.db
SUPABASE_URL=
SUPABASE_KEY=

# Autonomous workflow scheduler (disabled by default)
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=UTC
MONDAY_WORKFLOW_HOUR=6
MONDAY_WORKFLOW_MINUTE=0

# Daily workflow (uses Europe/Helsinki by default so daylight-saving changes
# are handled by the IANA timezone database)
DAILY_WORKFLOW_HOUR=6
DAILY_WORKFLOW_MINUTE=0
DAILY_WORKFLOW_TIMEZONE=Europe/Helsinki

# Weekly aggregate report (previous completed week)
WEEKLY_WORKFLOW_HOUR=6
WEEKLY_WORKFLOW_MINUTE=0
WEEKLY_WORKFLOW_TIMEZONE=Europe/Helsinki

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_ENABLED=false
BACKEND_BASE_URL=http://127.0.0.1:8000

# RAG services and paths
GEMINI_API_KEY=
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION_NAME=academic_knowledge
# Relative paths are resolved from the process working directory.
# Leave these unset to use the project defaults.
# KNOWLEDGE_BASE_DIR=../docs/knowledge_base
# RAG_EVALUATION_DATASET=../rag/evaluation/evaluation_dataset.json
# RAG_EVALUATION_REPORTS_DIR=../rag/evaluation/reports
