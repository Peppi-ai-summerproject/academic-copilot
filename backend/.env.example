APP_NAME=AI Academic Copilot API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

DATABASE_URL=sqlite:///./academic_copilot.db
SUPABASE_URL=
SUPABASE_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_ENABLED=false
BACKEND_BASE_URL=http://127.0.0.1:8000

# RAG services and paths
GEMINI_API_KEY=
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION_NAME=academic_knowledge
